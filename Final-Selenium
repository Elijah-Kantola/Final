using System;
using System.Text;
      
[TestClass]
    public class Test
    {
        private static IWebDriver driver = new ChromeDriver();

        [TestMethod]
        public void TestValid()
        {
            driver.Navigate().GoToUrl("https://www.yourlearningpal.com/login");
            driver.FindElement(By.XPath("//div[@id='root']/div/div/div/section/div/div/div/form/div/div/div[2]/div")).Click();
            driver.FindElement(By.Id("txtUser")).Click();
            driver.FindElement(By.Id("txtUser")).Clear();
            driver.FindElement(By.Id("txtUser")).SendKeys("test1");
            driver.FindElement(By.Id("txtPassword")).Click();
            driver.FindElement(By.Id("txtPassword")).Clear();
            driver.FindElement(By.Id("txtPassword")).SendKeys("Test12456");
            driver.FindElement(By.Id("txtPassword")).SendKeys(Keys.Enter);
            wait.Until(ExpectedConditions.UrlContains("dashboard/enrolled"));
            Assert.IsTrue(driver.Url.Contains("dashboard/enrolled"));
        } 
    }



[TestClass]
    public class Test2
    {
        private static IWebDriver driver = new ChromeDriver();
        
        [TestMethod]
        public void TestInvalid()
        {
            driver.Navigate().GoToUrl("https://www.yourlearningpal.com/login");
            driver.FindElement(By.Id("txtUser")).Click();
            driver.FindElement(By.Id("txtUser")).Clear();
            driver.FindElement(By.Id("txtUser")).SendKeys("test1");
            driver.FindElement(By.Id("txtPassword")).Click();
            driver.FindElement(By.Id("txtPassword")).Clear();
            driver.FindElement(By.Id("txtPassword")).SendKeys("test1234");
            driver.FindElement(By.Id("txtPassword")).SendKeys(Keys.Enter);
            wait.Until(ExpectedConditions.UrlContains("login"));
            Assert.IsTrue(driver.Url.Contains("login"));
            Assert.IsFalse(driver.Url.Contains("dashboard/enrolled"));
        }
    }